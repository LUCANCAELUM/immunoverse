{
  "name": "immunoverse",
  "version": "2.0.0",
  "private": true,
  "description": "IMMUNOVERSE – offline-first immunology & biomedical research command centre (Android app via Capacitor)",
  "scripts": {
    "test": "node tests/run.js",
    "serve": "npx http-server www -p 8080 -c-1",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
